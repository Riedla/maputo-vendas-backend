# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sistema_vendedores

# JWT Configuration (use uma string longa e aleatória)
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=3000
NODE_ENV=development
# Origens permitidas para CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Google Maps API (opcional — sem chave, a distância/tempo são estimados)
GOOGLE_MAPS_API_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
